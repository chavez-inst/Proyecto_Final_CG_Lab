# ---------- librerias externas ----------
# glm, glew, glfw, assimp, stb_image y las DLLs se pasan aparte en Librerias.zip
Librerias/
*.zip


# ---------- lo que genera Visual Studio al compilar ----------
build/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Oo]ut/
*.exe
*.dll
*.lib
*.pdb
*.ilk
*.exp
*.idb
*.iobj
*.ipdb
*.pch
*.tlog
*.lastbuildstate
*.recipe
*.log


# ---------- archivos de sesion de visual studio ----------
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.VC.db
*.VC.VC.opendb
*.opendb
*.sdf
*.ipch
ipch/
*.aps
*.ncb
*.cachefile
enc_temp_folder/

# otros editores (por si acaso)
.vscode/
.idea/


# ---------- de programas de modelado ----------
# Blender (.blend1, .blend2...)
*.blend[0-9]
*.blend[0-9][0-9]
# 3ds Max / Maya
*.max.bak
autoback/
Autobackup/
incrementalSave/
*.blend
*.max
*.ma
*.mb
Blender/


# ---------- archivos temps ----------
*.tmp
*.temp
*.bak
*.swp
*~
~$*


# ---------- archivos basura ----------
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store
